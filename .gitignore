# Build products. Everything here is produced by `make`, so none of it belongs
# in git: the runtime is 24 MB of upstream DLLs plus our own builds.
build/
dist/
runtime/*.exe
runtime/*.dll
runtime/.patched

# Built copies of the shim live in runtime/; the canonical DLL is produced by
# `make` from src/shim/*.c, so do not commit a prebuilt one either.
src/shim/*.dll
runtime/out.wav
runtime/_diag_*

# The model is 79 MB. Users fetch it with scripts\get_model.cmd.
models/

# Python
__pycache__/
*.pyc

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# NOTE: src/shim/imports.txt IS committed. It is generated by
# scan_imports.py from the pinned upstream release, and committing it lets a
# reviewer see exactly which Windows APIs the shim must satisfy.
