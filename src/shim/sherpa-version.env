# Pinned upstream release used to build this package.
#
# Bump this to upgrade: change SHERPA_VERSION to a new tag, then run
#     make upgrade
# which re-downloads the release, regenerates imports.txt from the new
# binaries, rebuilds the shim, re-patches everything and runs the self-test.
# See docs/upgrading-sherpa.md for the full procedure.

SHERPA_VERSION=1.13.8

# Name of the Windows x64 shared release asset. Keep the -MD-Release suffix:
# the Debug and MinSizeRel variants import extra Windows-only DLLs.
SHERPA_WIN_ASSET=sherpa-onnx-v$(SHERPA_VERSION)-win-x64-shared-MD-Release.tar.bz2

# Files patched with w7shim.dll. All three are required: the CLI imports the
# C API, and the C API imports onnxruntime, which is where the Windows 8+
# imports live.
SHERPA_PATCH_BINS="bin/sherpa-onnx-offline-tts.exe lib/sherpa-onnx-c-api.dll lib/onnxruntime.dll"

# Import DLLs redirected to the shim. dxgi.dll is redirected because
# onnxruntime.dll statically imports CreateDXGIFactory2 (DXGI 1.2, Windows 8).
SHERPA_REDIRECT_DLLS="KERNEL32.dll api-ms-win-core-path-l1-1-0.dll dxgi.dll"
